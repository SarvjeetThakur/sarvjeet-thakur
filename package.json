{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,presence -c cyan,magenta \"next dev\" \"node server/presence.mjs\"",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --max-warnings 0",
    "lint:fix": "oxlint --fix --max-warnings 0",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "next typegen && tsc --noEmit",
    "dev:ws": "node server/presence.mjs",
    "dev:next": "next dev",
    "prepare": "husky"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@use-gesture/react": "^10.3.1",
    "lucide-react": "^1.54.0",
    "matter-js": "^0.20.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.180.0",
    "@types/ws": "^8.18.2",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^10.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "1.86.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "ws": "^8.22.0"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "oxlint --fix --max-warnings 0",
      "oxfmt"
    ],
    "*.{json,jsonc,css,md,yaml,yml}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=20.9"
  },
  "packageManager": "pnpm@12.10.1"
}
