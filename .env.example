# Absolute origin of the deployed site. Without it the canonical URL, the
# sitemap, robots.txt and the Open Graph image URL all point at localhost.
# On Vercel this falls back to the project's production domain automatically,
# so it is only required for a custom domain.
NEXT_PUBLIC_SITE_URL=https://example.com

# Where live presence connects, as a full origin. Leave it unset and presence
# is simply off: it needs a long-lived WebSocket server, which Vercel and most
# static hosts cannot run. Set it only if you deploy `server/presence.mjs`
# somewhere that can (Fly, Railway, Render, a VPS).
# NEXT_PUBLIC_PRESENCE_URL=wss://presence.example.com

# Port `server/presence.mjs` listens on, and the port the browser uses in
# development. Only used locally; ignored in production.
NEXT_PUBLIC_PRESENCE_PORT=3001
